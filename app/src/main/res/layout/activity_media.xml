<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".main.ui.activity.MediaActivity"
    android:background="?attr/ActivityBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:padding="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backFromMediaButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:src="@drawable/ic_back"
            android:background="?attr/ButtonsColor"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/media"
            android:textColor="?attr/TextViewActivityColor"
            android:textSize="@dimen/text_size_22"
            android:gravity="center_vertical"
            android:fontFamily="@font/ys_display_medium"
            />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/ActivityBackgroundColor"
        app:tabIndicatorColor="?attr/TabIndicatorColor"
        app:tabTextAppearance="@style/TabTextStyle"
        app:tabTextColor="?attr/TextViewActivityColor"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>