<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FrameLayoutMainActivityStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="LinearLayoutMainActivityStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ButtonMainActivityStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
    </style>

    <style name="TextViewMainActivityStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/text_view_margin_start_main</item>
        <item name="android:textSize">@dimen/text_size_22</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="ImageViewMainActivityStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="FrameLayoutSettingsActivityStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/fr_layout_height_settings</item>
        <item name="android:padding">@dimen/padding</item>
    </style>

    <style name="TextViewSettingsActivityStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="ImageButtonSettingsActivityStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">2dp</item>
    </style>

    <style name="SearchStubPicStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginTop">210dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="SearchStubTextStyle">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">346dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:visibility">gone</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SearchActivityButtonsStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:backgroundTint">?attr/SearchActivityButtonColor</item>
        <item name="android:textColor">?attr/SearchActivityButtonTextColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AudioActivityLeftTextViewStyle">
        <item name="android:layout_width">124dp</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="AudioActivityRightTextViewStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/TextViewActivityColor</item>
        <item name="android:gravity">end</item>
    </style>
</resources>